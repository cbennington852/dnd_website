<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fabric.js Shape & Draw Board</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>
    <style>
        body { font-family: sans-serif; margin: 20px; }
        .controls { margin-bottom: 15px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        button { padding: 8px 12px; cursor: pointer; background-color: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; }
        button:hover { background-color: #e0e0e0; }
        button.active { background-color: #007bff; color: white; border-color: #0056b3; }
        .canvas-container { border: 1px solid #000; }
    </style>
</head>
<body>

    <div class="controls">
        <button id="drawModeBtn" class="active" onclick="enableDrawing(true)"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M160-120v-170l527-526q12-12 27-18t30-6q16 0 30.5 6t25.5 18l56 56q12 11 18 25.5t6 30.5q0 15-6 30t-18 27L330-120H160Zm80-80h56l393-392-28-29-29-28-392 393v56Zm560-503-57-57 57 57Zm-139 82-29-28 57 57-28-29ZM560-120q74 0 137-37t63-103q0-36-19-62t-51-45l-59 59q23 10 36 22t13 26q0 23-36.5 41.5T560-200q-17 0-28.5 11.5T520-160q0 17 11.5 28.5T560-120ZM183-426l60-60q-20-8-31.5-16.5T200-520q0-12 18-24t76-37q88-38 117-69t29-70q0-55-44-87.5T280-840q-45 0-80.5 16T145-785q-11 13-9 29t15 26q13 11 29 9t27-13q14-14 31-20t42-6q41 0 60.5 12t19.5 28q0 14-17.5 25.5T262-654q-80 35-111 63.5T120-520q0 32 17 54.5t46 39.5Z"/></svg> </button>
        <button id="selectModeBtn" onclick="enableDrawing(false)"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M480-80 310-250l57-57 73 73v-206H235l73 72-58 58L80-480l169-169 57 57-72 72h206v-206l-73 73-57-57 170-170 170 170-57 57-73-73v206h205l-73-72 58-58 170 170-170 170-57-57 73-73H520v205l72-73 58 58L480-80Z"/></svg></button>
        
        |
        
        <label for="colorPicker">Color: </label>
        <input type="color" id="colorPicker" value="#000000" onchange="changeColor(this.value)">
        
        |
        
        <button onclick="addRectangle()">□</button>
        <button onclick="addCircle()">◯</button>
        <button onclick="addTriangle()">△</button>
        
        |
        
        <button onclick="saveDrawing()" style="background-color: #28a745; color: white;">Save</button>
        <button onclick="canvas.clear(); enableDrawing(true);" style="background-color: #dc3545; color: white;">Clear All</button>
    </div>

    <canvas id="canvas" width="300" height="300"></canvas>

    <script>
      // Initialize Canvas
      const canvas = new fabric.Canvas('canvas');
      canvas.isDrawingMode = true; 
      canvas.freeDrawingBrush.width = 5; // Set a nice default brush width

      // Keep track of the current selected color
      let currentColor = '#000000';

      // Toggle between Drawing Mode and Selection Mode
      function enableDrawing(isDrawing) {
        canvas.isDrawingMode = isDrawing;
        
        // Update UI button highlights
        document.getElementById('drawModeBtn').classList.toggle('active', isDrawing);
        document.getElementById('selectModeBtn').classList.toggle('active', !isDrawing);
      }

      // Change brush color
      function changeColor(color) {
        currentColor = color;
        canvas.freeDrawingBrush.color = color;
      }

      // Add a Rectangle
      function addRectangle() {
        enableDrawing(false); // Switch to select mode so user can interact with the shape
        const rect = new fabric.Rect({
          left: 100,
          top: 100,
          fill: currentColor,
          width: 100,
          height: 60,
        });
        canvas.add(rect);
      }

      // Add a Circle
      function addCircle() {
        enableDrawing(false);
        const circle = new fabric.Circle({
          left: 150,
          top: 150,
          fill: currentColor,
          radius: 40
        });
        canvas.add(circle);
      }

      // Add a Triangle
      function addTriangle() {
        enableDrawing(false);
        const triangle = new fabric.Triangle({
          left: 200,
          top: 100,
          fill: currentColor,
          width: 80,
          height: 80
        });
        canvas.add(triangle);
      }

      // Save to localStorage (Saves both brush strokes and shapes!)
      function saveDrawing() {
        const jsonString = JSON.stringify(canvas.toJSON());
        const byteSize = new Blob([jsonString]).size;
        console.log(`Size: ${byteSize} bytes`);
        localStorage.setItem('myCanvasDrawing', jsonString);
        alert('Drawing and shapes saved!');
      }

      // Load from localStorage
      function loadDrawing() {
        const saved = localStorage.getItem('myCanvasDrawing');
        if (saved) {
          canvas.loadFromJSON(saved, function() {
            canvas.renderAll();
          });
        }
      }

      // Auto-load on page start
      window.onload = loadDrawing;
    </script>

</body>
</html>