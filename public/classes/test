<style>
  /* Base trigger button styling */
#openModalBtn {
  padding: 10px 20px;
  font-size: 16px;
  cursor: pointer;
}

/* Background overlay (hidden by default) */
.modal-overlay {
  display: none; 
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5); /* Dimmed background */
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

/* The actual popup box */
.modal-content {
  background-color: #2a2a2a;
  padding: 30px;
  width: 100%;
  max-width: 500px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  animation: fadeIn 0.3s ease;
}

/* Smooth fade-in animation */
@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

</style>





<script>
  // Get DOM Elements
const modal = document.getElementById('editModal');
const openModalBtn = document.getElementById('openModalBtn');
const cancelBtn = document.getElementById('cancelBtn');
const editForm = document.getElementById('editForm');

// 1. Open the popup when the main button is clicked
openModalBtn.addEventListener('click', () => {
  modal.style.display = 'flex'; // Triggers flex centering layout
});

// 2. Close the popup when clicking 'Cancel'
cancelBtn.addEventListener('click', () => {
  modal.style.display = 'none';
});

// 3. Optional: Close the popup if clicking outside the modal box
window.addEventListener('click', (event) => {
  if (event.target === modal) {
    modal.style.display = 'none';
  }
});

// 4. Handle form submission (Save Changes)
editForm.addEventListener('submit', (e) => {
  e.preventDefault(); // Stop page from reloading
  
  // Quick way to collect all form fields data
  const formData = new FormData(editForm);
  const updatedData = Object.fromEntries(formData.entries());
  
  // At this point, 'updatedData' is an object containing your 6 fields
  console.log('Saved Data:', updatedData);
  
  // Close the modal after saving
  modal.style.display = 'none';
});
</script>